{
    "dialpad": {
        "renderTargets": [
            "dialpad",
            {
                "root": {
                    "elementId": "dialpad_custom_tweaked"
                },
                "data": {
                    "dialed": {
                        "show": true,
                        "filter": {
                            "show": false
                        },
                        "convert": {
                            "show": false
                        }
                    },
                    "dialpad": {
                        "show": false
                    },
                    "controls": {
                        "show": true
                    }
                }
            }
        ]
    },
    "callControl": {
        "renderTargets": [
            "call_control"
        ]
    },
    "call": {
        "autoAnswer": {
            "enabled": true,
            "muteMicrophone": false,
            "onlyWhenIdle": false
        }
    },
    "conference": {
        "enabled": true,
        "maxParticipants": 5
    },
    "mediaDevices": {
        "audioinput": {
            "preferedDeviceIds": []
        },
        "videoinput": {
            "enabled": true,
            "preferedDeviceIds": [
                "none"
            ]
        },
        "renderTargets": [
            "media_device",
            {
                "root": {
                    "elementId": "media_device_tweaked"
                },
                "data": {
                    "ringoutput": {
                        "show": false
                    },
                    "ringoutput2": {
                        "show": false
                    },
                    "audiooutput": {
                        "show": false
                    },
                    "audioinput": {
                        "show": false
                    }
                }
            }
        ]
    },
    "audioContext": {
        "channels": {
            "ringer": {
                "alertInfo": {
                    "mappings": {
                        "alert-internal": "ring03",
                        "alert-external": "ring01",
                        "door-phone": "ring09"
                    }
                },
                "callWaiting": {
                    "enabled": true,
                    "interval": 30
                },
                "autoAnswerWarning": {
                    "enabled": true
                }
            }
        },
        "renderTargets": [
            {
                "root": {
                    "elementId": "audio_context"
                },
                "section": "volumes"
            },
            {
                "root": {
                    "elementId": "audio_context_tweaked"
                },
                "section": "volumes",
                "data": {
                    "channels": {
                        "ringer": {
                            "show": false
                        },
                        "tones": {
                            "show": false
                        },
                        "preview": {
                            "show": false
                        }
                    }
                }
            },
            {
                "root": {
                    "elementId": "audio_context_ringtones"
                },
                "section": "ringtones"
            },
            {
                "root": {
                    "elementId": "audio_context_callwaiting"
                },
                "section": "callwaiting"
            },
            {
                "root": {
                    "elementId": "audio_context_autoanswer"
                },
                "section": "autoanswerwarning"
            }
        ]
    },
    "codecPreferences": {
        "audio": [
            "OPUS"
        ],
        "video": []
    },
    "userAgent": {
        "renderTargets": [
            "user_agent"
        ],
        "transport": {
            "sockets": [
                "wss://your-sip-server.example.com:5065"
            ],
            "recovery_max_interval": 30,
            "recovery_min_interval": 2
        },
        "authentication": {
            "username": "your-sip-username",
            "password": "your-sip-password",
            "realm": "your-sip-realm.example.com"
        },
        "user_agent": {
            "instance_id": "generate-your-own-uuid-here",
            "no_answer_timeout": 60,
            "register": true,
            "register_expires": 300,
            "user_agent": "libwebphone 2.x - dev"
        }
    },
    "videoCanvas": {
        "canvas": "video_screen",
        "renderTargets": [
            "video_controls"
        ]
    },
    "blf": {
        "enabled": true,
        "renderTargets": [
            "blf_default"
        ],
        "keys": [],
        "subscribe_expires": 1800,
        "resubscribe_delay": 1000,
        "max_resubscribe_delay": 60000,
        "notify_timeout": 60000
    },
    "quickConnect": [
        {
            "label": "Quick Connect Example",
            "username": "your-sip-username",
            "password": "your-sip-password"
        }
    ]
}
